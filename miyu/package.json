{
  "name": "miyu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"lib/**/*.test.ts\" \"server/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:saju && npm run build",
    "test:db": "node --test --test-concurrency=1 supabase/tests/db.test.ts supabase/tests/benefits.db.test.ts supabase/tests/compat.db.test.ts supabase/tests/pairs.db.test.ts supabase/tests/reviews.db.test.ts supabase/tests/record-delete.db.test.ts supabase/tests/record-purge.db.test.ts supabase/tests/pair-purge.db.test.ts",
    "test:saju": "node --test lib/saju/engine.check.ts",
    "deps": "node scripts/check-deps.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tosspayments/tosspayments-sdk": "2.8.1",
    "manseryeok": "2.0.0",
    "next": "16.4.0",
    "pretendard": "^1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "astronomy-engine": "2.1.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "korean-lunar-calendar": "0.4.0",
    "lunar-javascript": "1.7.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
