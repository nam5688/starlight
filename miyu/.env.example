# ME:U(미유) 환경변수 목록 — 이름과 설명만 적는다. 실제 값은 여기에 쓰지 않는다.
#
# 사용 방법 (Windows PowerShell, miyu 폴더에서):
#   Copy-Item .env.example .env.local
#   notepad .env.local
# .env.local 은 git에 올라가지 않는다. 배포 시에는 Vercel 프로젝트 설정 > Environment Variables 에 입력한다.
# 비밀키는 대화창이나 코드에 붙여넣지 않는다. 값을 얻는 방법은 docs/setup-guide.md 참고.
# 값이 비어 있으면 해당 기능은 "설정 전"으로 표시되고 동작하지 않는다.

# --- 서비스 주소 ---
# 로그인 후 돌아올 주소에 쓴다. 로컬은 http://localhost:3000, 배포 후에는 실제 주소
SITE_URL=

# --- Supabase (회원·결과 저장) ---
# 프로젝트 주소 (공개돼도 되는 값)
NEXT_PUBLIC_SUPABASE_URL=
# 공개용 키 (publishable key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 비밀키 (secret key) — 절대 NEXT_PUBLIC_ 를 붙이지 않는다
SUPABASE_SECRET_KEY=
# 카카오 로그인 키는 Supabase 대시보드(Authentication > Providers > Kakao)에 넣으므로 여기에는 두지 않는다

# --- 토스페이먼츠 (주문서형 결제위젯 키) ---
# 결제 화면용 클라이언트 키 (test_gck_... 로 시작)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# 결제 승인용 시크릿 키 (test_gsk_... 로 시작) — 서버 전용
TOSS_SECRET_KEY=
# 실결제 여부. 운영자 승인 전에는 false 로 둔다 (false면 test_ 키만 받는다)
PAYMENTS_LIVE_MODE=false
# 로컬 자동 검증에서만 쓰는 값. 비워 둔다.
TOSS_API_BASE_URL=
# 결제 화면에 보일 결제수단 구성(결제 UI)의 이름. 비우면 DEFAULT. 출시 초기에는 카드만 보여야 하는데, 토스 어드민의 DEFAULT 구성에서 카드 외 결제수단을 끌 수 없다면
# 어드민에서 카드만 있는 결제 UI를 새로 만들고 그 variantKey를 여기에 적는다 (비밀값이 아니다. 값을 바꾼 뒤에는 다시 배포해야 반영된다) — docs/setup-guide.md
TOSS_WIDGET_VARIANT_KEY=

# --- 리포트 생성 + 채팅 질문의 실제 AI(Claude) — 운영자가 승인 금액 · 호출 수 · 기간을 직접 적기 전에는 호출하지 않는다 ---
# 비워 두면 개발용 규칙 생성기를 쓴다 (비용 없음). anthropic이면 아래 승인 값이 모두 있어야 하고, 하나라도 없거나 상한을 넘으면 호출하지 않는다.
#  (mock-local은 로컬 검증용 가짜 AI 서버 — 비용 없음)
AI_PROVIDER=
# AI_PROVIDER=mock-local 일 때만: 로컬 가짜 AI 서버 주소 (http://127.0.0.1:포트). 비워 둔다.
AI_MOCK_URL=
# 채팅 질문(자유 질문)도 실제 AI로 답하게 하려면 anthropic. 비우면 채팅은 "준비 중"이다 (AI_PROVIDER와 따로 켠다).
AI_CHAT_PROVIDER=
# 리포트와 채팅이 같은 승인 · 같은 장부를 나눠 쓴다 — 승인 금액은 둘을 합친 한도다.
# 운영자 승인 2026-10-15: 5,000원. 코드 상한: 5,000원 · 호출 60회 · 7일. 이 안에서만 호출하고, 다음 호출이 넘길 수 있으면 제공사에 요청을 보내지 않는다.
# 호출 수는 고쳐 쓰기 · 재시도를 포함한 모델 호출 횟수다 (리포트 한 건은 보통 1~2회, 질문 한 번은 1~2회).
AI_APPROVED_KRW=
AI_APPROVED_CALLS=
# 승인 기간(한국 날짜 YYYY-MM-DD, 양 끝 포함, 최대 7일)
AI_APPROVED_FROM=
AI_APPROVED_THROUGH=
# 환율 가정(원 / 1달러). 비우면 1,600. 실제 청구는 Anthropic 콘솔의 사용량으로 확인한다.
AI_FX_KRW_PER_USD=
# 로컬 시험 서버 주소(http://127.0.0.1:포트)만 쓸 수 있다. 실제 호출에서는 비워 둔다.
AI_BASE_URL=
# 서버 전용 키 — 이 파일 · 대화 · 커밋에 값을 적지 않고 .env.local에 직접 입력한다. 회사 콘솔에서 월 사용 한도도 먼저 건다.
ANTHROPIC_API_KEY=

# --- 운영자 본인 입력 실제 AI 시험 전용(docs/real-ai-run-guide.md 7장) — 이 PC의 개발 서버에서만 동작, 운영 · Vercel에서는 적어도 꺼져 있다 ---
# yes로 적으면 /analyze에서 푼 22문항 응답을 이 PC의 pilot-data/own-input 파일에만 남긴다(DB · 외부로 보내지 않는다). 시험이 끝나면 지운다.
MIYU_OWN_INPUT_CAPTURE=

# --- AI 품질 비교 전용 (서비스 설정 AI_PROVIDER와 별개, 운영자가 단계별 예산을 승인한 뒤에만 입력) ---
# scripts/run-ai-compare.ts 가 읽는다. 비교를 내 PC에서 실행할 때만 .env.local 에 직접 입력한다 (호스팅 환경변수에는 넣지 않는다).
# 키는 대화 · 문서 · 커밋에 붙여넣지 않는다.
OPENAI_API_KEY=

# --- 운영 (결제 재확인 · 알림 · 관리자) ---
# 관리자 화면(/admin)에 들어갈 수 있는 회원번호(Supabase > Authentication > Users 의 User UID). 쉼표로 여러 명.
# 비워 두면 관리자 화면은 누구에게도 열리지 않는다 (없는 주소처럼 보인다).
ADMIN_USER_IDS=
# 정기 점검 주소(/api/cron/reconcile) 인증값. 길고 추측하기 어려운 무작위 문자열.
# 비워 두면 정기 점검 주소는 닫혀 있다. 배포 후 Vercel Cron 또는 외부 예약 실행이 이 값을 Authorization: Bearer 로 보낸다.
CRON_SECRET=
# 텔레그램 운영 알림. 둘 다 있을 때만 텔레그램으로 보내고, 없으면 서버 로그에만 남긴다.
# 알림에는 주문번호 · 오류번호 · 종류만 들어간다 (고객 이름 · 생년월일 · 답변 · 분석 내용은 보내지 않는다).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 리포트 생성 용량 · AI 비용 한도 (AI를 연결한 뒤 의미가 있다) ---
# AI를 연결하기 전(개발용 규칙 생성기)에는 한도를 걸지 않는다. 비우면 기본값(AI 연결 시): 동시 생성 3, 새 구매 중단 기준 10건.
# 동시에 생성하는 최대 수. 가득 차면 이미 결제한 고객의 리포트는 대기열에서 순서를 기다린다 (취소되지 않는다).
AI_MAX_CONCURRENT=
# 대기 + 생성 중인 리포트가 이 수 이상이면 새 결제를 시작하지 못하게 한다 (결제는 진행되지 않고 바로 안내한다).
AI_SALE_QUEUE_LIMIT=
# 하루(한국 날짜) AI 예산(원). 비우거나 0이면 제한 없음. 예산에 가까워지면 새 구매를 멈추고 운영자에게 알린다.
AI_DAILY_BUDGET_KRW=
# 방마다 무료 질문 수는 코드(lib/config/product.ts의 CHAT_ROOMS)에서 정한다 — 무료 리포트(무료): 나를 알아보기 0 · 오늘의 운세 하루 1 · 고민 상담 2 · 연애 2, 심층 리포트: 방마다 3.
# 무료 질문을 다 쓰면 미유캐시(질문 한 번에 3캐시)로 이어 간다. 아래 값은 실제 AI 시험 중에만 열린 방마다 무료 질문을 이만큼 더 준다. 비우면 0이고, 시험이 끝나면 비운다.
AI_CHAT_EXTRA_QUESTIONS=
# --- (옛 방식) 채팅 전용 승인 — 위의 AI_APPROVED_*를 하나도 적지 않았을 때만 읽는다. 새 시험에는 쓰지 않는다 ---
AI_CHAT_APPROVED_KRW=
AI_CHAT_APPROVED_CALLS=
AI_CHAT_APPROVED_FROM=
AI_CHAT_APPROVED_THROUGH=
AI_CHAT_FX_KRW_PER_USD=
# 리포트 한 건의 예상 비용(원). 대기 중인 건을 예산에 미리 더하는 데 쓴다.
AI_EST_COST_KRW_PER_REPORT=
# 토큰 단가(원 / 100만 토큰). AI 제공사를 정한 뒤 공식 가격표를 보고 직접 넣는다. 비우면 호출 수만 기록한다.
AI_PRICE_INPUT_KRW_PER_MTOK=
AI_PRICE_OUTPUT_KRW_PER_MTOK=
# 리포트 한 번의 생성 시도에 허용하는 시간(초). 가짜 AI는 기본 240 · 최대 280, 실제 Claude는 기본 480 · 최대 540(실제 AI는 오래 걸릴 수 있다). 넘으면 실패로 기록하고 고객은 다시 만들기를 누를 수 있다 (완성으로 저장하지 않는다).
# ※ Vercel에 올릴 때는 270으로 적는다: Vercel 함수는 Hobby · Pro 모두 기본 300초이고 Hobby는 그 이상 늘릴 수 없어(Pro는 800초까지) 480초 기본값으로는 시간 제한에 먼저 끊긴다(공식 문서 2026-10-16). 실제 AI 리포트가 몇 초 걸리는지는 아직 재지 못했다.
AI_GENERATION_TIMEOUT_SECONDS=
# 같은 회원이 화면을 계속 열어도 결제 재확인을 이 간격(초)에 한 번만 한다 (기본 60). 자동 검증에서만 0으로 쓴다.
RECONCILE_USER_INTERVAL_SECONDS=
