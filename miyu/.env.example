# ME:U(미유) 환경변수 목록 — 이름과 설명만 적는다. 실제 값은 여기에 쓰지 않는다.
#
# 사용 방법 (Windows PowerShell, miyu 폴더에서):
#   Copy-Item .env.example .env.local
#   notepad .env.local
# .env.local 은 git에 올라가지 않는다. 배포 시에는 Vercel 프로젝트 설정 > Environment Variables 에 입력한다.
# 비밀키는 대화창이나 코드에 붙여넣지 않는다. 값을 얻는 방법은 docs/setup-guide.md 참고.
# 값이 비어 있으면 해당 기능은 "설정 전"으로 표시되고 동작하지 않는다.

# --- 서비스 주소 ---
# 로그인 후 돌아올 주소에 쓴다. 로컬은 http://localhost:3000, 배포 후에는 실제 주소
SITE_URL=

# --- Supabase (회원·결과 저장) ---
# 프로젝트 주소 (공개돼도 되는 값)
NEXT_PUBLIC_SUPABASE_URL=
# 공개용 키 (publishable key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 비밀키 (secret key) — 절대 NEXT_PUBLIC_ 를 붙이지 않는다
SUPABASE_SECRET_KEY=
# 카카오 로그인 키는 Supabase 대시보드(Authentication > Providers > Kakao)에 넣으므로 여기에는 두지 않는다

# --- 토스페이먼츠 (주문서형 결제위젯 키) ---
# 결제 화면용 클라이언트 키 (test_gck_... 로 시작)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# 결제 승인용 시크릿 키 (test_gsk_... 로 시작) — 서버 전용
TOSS_SECRET_KEY=
# 실결제 여부. 운영자 승인 전에는 false 로 둔다 (false면 test_ 키만 받는다)
PAYMENTS_LIVE_MODE=false
# 로컬 자동 검증에서만 쓰는 값. 비워 둔다.
TOSS_API_BASE_URL=

# --- 리포트 생성 (AI 해석) ---
# 비워 두면 개발용 규칙 생성기를 쓴다 (비용 없음).
# 실제 AI 제공사는 운영자가 고르고 승인한 뒤에 추가한다. 지금 쓸 수 있는 값은 로컬 검증용 mock-local 뿐이다.
AI_PROVIDER=
# AI_PROVIDER=mock-local 일 때만: 로컬 가짜 AI 서버 주소 (http://127.0.0.1:포트). 비워 둔다.
AI_MOCK_URL=
# 실제 제공사 연결 후 쓰는 서버 전용 키 (아직 쓰지 않음)
AI_API_KEY=

# --- 운영 (결제 재확인 · 알림 · 관리자) ---
# 관리자 화면(/admin)에 들어갈 수 있는 회원번호(Supabase > Authentication > Users 의 User UID). 쉼표로 여러 명.
# 비워 두면 관리자 화면은 누구에게도 열리지 않는다 (없는 주소처럼 보인다).
ADMIN_USER_IDS=
# 정기 점검 주소(/api/cron/reconcile) 인증값. 길고 추측하기 어려운 무작위 문자열.
# 비워 두면 정기 점검 주소는 닫혀 있다. 배포 후 Vercel Cron 또는 외부 예약 실행이 이 값을 Authorization: Bearer 로 보낸다.
CRON_SECRET=
# 텔레그램 운영 알림. 둘 다 있을 때만 텔레그램으로 보내고, 없으면 서버 로그에만 남긴다.
# 알림에는 주문번호 · 오류번호 · 종류만 들어간다 (고객 이름 · 생년월일 · 답변 · 분석 내용은 보내지 않는다).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
