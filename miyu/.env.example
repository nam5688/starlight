# ME:U(미유) 환경변수 목록 — 이름과 설명만 적는다. 실제 값은 여기에 쓰지 않는다.
#
# 사용 방법 (Windows PowerShell, miyu 폴더에서):
#   Copy-Item .env.example .env.local
#   notepad .env.local
# .env.local 은 git에 올라가지 않는다. 배포 시에는 Vercel 프로젝트 설정 > Environment Variables 에 입력한다.
# 비밀키는 대화창이나 코드에 붙여넣지 않는다.
#
# 1단계에는 필요한 값이 없다. 아래는 2~4단계에서 쓸 예정이며, 이름은 구현할 때 공식 문서 기준으로 확정한다.

# --- 2단계: Supabase (회원·DB) ---
# 프로젝트 주소 (공개돼도 되는 값)
NEXT_PUBLIC_SUPABASE_URL=
# 공개용 키 (publishable key, 브라우저에서 사용)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 비밀키 (secret key) — 절대 NEXT_PUBLIC_ 를 붙이지 않는다
SUPABASE_SECRET_KEY=
# 카카오 로그인 키는 Supabase 대시보드(Authentication > Providers > Kakao)에 입력하므로 여기에는 두지 않는다

# --- 3단계: 토스페이먼츠 (결제) ---
# 결제창용 클라이언트 키 (테스트 키부터 사용)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# 결제 승인용 시크릿 키 — 서버 전용
TOSS_SECRET_KEY=
# 실결제 여부. 운영자 승인 전에는 false 로 둔다
PAYMENTS_LIVE_MODE=false

# --- 3단계: 리포트 생성 (AI 해석) ---
# AI API 키 — 서버 전용
AI_API_KEY=

# --- 4단계: 텔레그램 운영 알림 ---
# 봇 토큰 — 서버 전용
TELEGRAM_BOT_TOKEN=
# 알림을 받을 채팅 ID
TELEGRAM_CHAT_ID=
